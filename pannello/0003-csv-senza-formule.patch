---
diff --git a/src/utils/file.js b/src/utils/file.js
index e5f3438..6fc14db 100644
--- a/src/utils/file.js
+++ b/src/utils/file.js
@@ -33,13 +33,26 @@ export function b64_to_utf8 (str) {
   return decodeURIComponent(escape(window.atob(str)))
 }
 
+// Una cella che comincia con = + - @, tab o \r diventa una formula quando il
+// CSV si apre in un foglio di calcolo (CSV injection, OWASP): prende davanti
+// un apostrofo. null e undefined sono una cella vuota.
+function csvCell (value) {
+  let s = value === null || value === undefined ? '' : String(value)
+  if (/^[=+\-@\t\r]/.test(s)) {
+    s = "'" + s
+  }
+  return `"${s.replaceAll('"', '""')}"`
+}
+
 export function jsonToCsv (data) {
   let csv = ''
-  let keys = Object.keys(data[0])
-  csv += keys.join(',') + '\n'
-  data.forEach(row => {
-    csv += keys.map(key => `"${row[key].toString().replaceAll('"', '""')}"`).join(',') + '\n'
-  })
+  if (data && data.length > 0) {
+    const keys = Object.keys(data[0])
+    csv += keys.join(',') + '\n'
+    data.forEach(row => {
+      csv += keys.map(key => csvCell(row[key])).join(',') + '\n'
+    })
+  }
   return new Blob([csv], { type: 'text/csv' })
 }
 
